<Application x:Class="GSheetAutoConverter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgDark" Color="#121214"/>
            <SolidColorBrush x:Key="CardBg" Color="#1E1E22"/>
            <SolidColorBrush x:Key="CardBorder" Color="#2E2E35"/>
            <SolidColorBrush x:Key="AccentGreen" Color="#107C41"/>
            <SolidColorBrush x:Key="AccentGreenHover" Color="#149A52"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#9A9AA0"/>
            <SolidColorBrush x:Key="InputBg" Color="#16161A"/>
            <SolidColorBrush x:Key="InputBorder" Color="#3A3A42"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
