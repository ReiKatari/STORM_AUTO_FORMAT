<Window x:Class="GSheetAutoConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM AUTO FORMAT" Height="820" Width="840"
        MinHeight="720" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Custom Green Fill Toggle CheckBox (Without Checkmarks) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Toggle Track -->
                            <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="#2B2B32" BorderBrush="#3F3F48" BorderThickness="1" Margin="0,0,10,0">
                                <!-- Inner Knob / Fill -->
                                <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="#707078" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#107C41"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#149A52"/>
                                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled RadioButton for Mode Selection -->
        <Style TargetType="RadioButton" x:Key="ModeRadioStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RadioBorder" Background="#24242A" BorderBrush="#383842" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="Background" Value="#107C41"/>
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#149A52"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#107C41"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#2E2E35"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E48"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PresetChipButton">
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#107C41"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- File Paths Card -->
            <RowDefinition Height="Auto"/> <!-- Schedule System Card -->
            <RowDefinition Height="Auto"/> <!-- Settings & Checkboxes Card -->
            <RowDefinition Height="Auto"/> <!-- Status & Countdown Bar -->
            <RowDefinition Height="*"/>    <!-- Activity Log Card -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#107C41" Margin="0,0,14,0">
                    <Image x:Name="ImgHeaderIcon" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="STORM AUTO FORMAT" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Автоматическая конвертация .gsheet файла в Excel по расписанию или интервалу" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnMinimizeToTrayHeader" Click="BtnMinimizeToTray_Click" Content="📌 Свернуть в трей" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- File Paths Card -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <!-- GSheet Input -->
                <TextBlock Text="Исходный файл Google Sheets (.gsheet) или ссылка:" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtGSheetPath" Grid.Column="0" ToolTip="Перетащите файл сюда или нажмите 'Обзор...'" TextChanged="TxtGSheetPath_TextChanged"/>
                    <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnBrowseGSheet_Click"/>
                </Grid>

                <!-- XLSX Output -->
                <TextBlock Text="Файл назначения Excel (.xlsx):" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtXlsxPath" Grid.Column="0" TextChanged="TxtXlsxPath_TextChanged"/>
                    <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnBrowseXlsx_Click"/>
                </Grid>

                <TextBlock Text="💡 Сохраняет 100% форматирования (шрифты, цвета, формулы, границы, объединения ячеек)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Schedule & Frequency System Card -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Режим и время выгрузки" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="BtnConvertNow" Content="⚡ Сконвертировать сейчас" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="BtnConvertNow_Click"/>
                </Grid>

                <!-- Mode Selector Radio Segmented Control -->
                <WrapPanel Margin="0,0,0,14">
                    <RadioButton x:Name="RadModeInterval" Content="⏱ По интервалу (минуты)" Style="{StaticResource ModeRadioStyle}" Checked="SyncMode_Changed"/>
                    <RadioButton x:Name="RadModeScheduled" Content="🕒 По точным часам (HH:mm)" Style="{StaticResource ModeRadioStyle}" Checked="SyncMode_Changed"/>
                </WrapPanel>

                <!-- Panel 1: Interval Mode Settings -->
                <Border x:Name="PnlIntervalMode" Background="#18181D" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,0">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="Периодичность (минут):" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtIntervalMinutes" Width="70" Text="5" TextAlignment="Center" TextChanged="TxtIntervalMinutes_TextChanged" Margin="0,0,16,0"/>

                            <TextBlock Text="Быстрый выбор:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="1 мин" Style="{StaticResource PresetChipButton}" Click="BtnPresetInterval_Click" Tag="1"/>
                            <Button Content="5 мин" Style="{StaticResource PresetChipButton}" Click="BtnPresetInterval_Click" Tag="5"/>
                            <Button Content="15 мин" Style="{StaticResource PresetChipButton}" Click="BtnPresetInterval_Click" Tag="15"/>
                            <Button Content="30 мин" Style="{StaticResource PresetChipButton}" Click="BtnPresetInterval_Click" Tag="30"/>
                            <Button Content="60 мин (1ч)" Style="{StaticResource PresetChipButton}" Click="BtnPresetInterval_Click" Tag="60"/>
                        </WrapPanel>
                        <TextBlock Text="Выгрузка будет выполняться автоматически каждые N минут без остановки." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Panel 2: Scheduled Time Mode Settings -->
                <Border x:Name="PnlScheduledMode" Background="#18181D" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="Время выгрузки (через запятую):" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtScheduledTimes" Width="200" Text="09:00, 14:00, 18:00" TextChanged="TxtScheduledTimes_TextChanged" ToolTip="Введите одно или несколько значений времени через запятую, например: 09:00, 14:30, 18:00" Margin="0,0,16,0"/>

                            <TextBlock Text="Шаблоны:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="09:00" Style="{StaticResource PresetChipButton}" Click="BtnPresetTime_Click" Tag="09:00"/>
                            <Button Content="12:00, 18:00" Style="{StaticResource PresetChipButton}" Click="BtnPresetTime_Click" Tag="12:00, 18:00"/>
                            <Button Content="09:00, 14:00, 18:00" Style="{StaticResource PresetChipButton}" Click="BtnPresetTime_Click" Tag="09:00, 14:00, 18:00"/>
                        </WrapPanel>
                        <TextBlock Text="Выгрузка будет происходить ежедневно строго в указанные часы и минуты (например: 09:00, 13:30, 18:00)." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Settings & Checkboxes Card -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoStart" Content="Автозапуск с Windows" Margin="0,0,24,0" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                    <CheckBox x:Name="ChkMinimizeOnClose" Content="Сворачивать в трей при закрытии" Margin="0,0,0,0" Checked="ChkMinimizeOnClose_Changed" Unchecked="ChkMinimizeOnClose_Changed"/>
                </WrapPanel>

                <!-- Advanced Auth Cookie -->
                <Expander Header="Расширенные настройки доступа (для закрытых Google Таблиц)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="Google Cookie / Session Token (F12 → Network → Cookie заголовок):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGoogleCookie" FontSize="11" Height="26" ToolTip="Cookie заголовок для авторизованного доступа к приватным таблицам" TextChanged="TxtGoogleCookie_TextChanged"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Status & Countdown Bar -->
        <Border Grid.Row="4" Background="#16161A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5" Background="#107C41" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Готов к работе" FontWeight="SemiBold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LblCountdownPrefix" Text="⏱ Следующее авто-обновление через: " FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCountdown" Text="05:00" FontWeight="Bold" FontSize="13" Foreground="#4CC2FF" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Activity Log Card -->
        <Border Grid.Row="5" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" MinHeight="220">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Журнал активности" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                    <Button Content="Очистить лог" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="11" Click="BtnClearLog_Click"/>
                </Grid>

                <ListBox Grid.Row="1" x:Name="LstLog" Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Foreground="#D0D0D0" FontFamily="Consolas, Segoe UI" FontSize="12" Padding="6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
